[%General]
author=Phob1an
comment=Luna Silver for my Expose series
left_tabs=true
attach_active_tab=true
active_tab_overlap=3
group_toolbar_buttons=false
spread_progressbar=false
spread_header=false
#progressbar_thickness=1.0font
composite=false
menu_shadow_depth=0
tooltip_shadow_depth=0
scroll_min_extent=32
slider_width=3
slider_handle_width=24
slider_handle_length=12
center_toolbar_handle=false
toolbar_interior_spacing=2
toolbar_item_spacing=2
x11drag=all
scroll_width=16
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=1
vertical_spin_indicators=false
translucent_windows=false
blurring=false
popup_blurring=false
toolbar_icon_size=16
animate_states=false
alt_mnemonic=true
button_contents_shift=true
button_icon_size=16
combo_as_lineedit=false
combo_menu=false
combo_focus_rect=false
square_combo_button=true
fill_rubberband=false
groupbox_top_label=false
inline_spin_indicators=true
remove_extra_frames=false
joined_inactive_tabs=false
no_inactive_tab_expansion=true
tab_button_extra_margin=2
large_icon_size=32
layout_margin=4
layout_spacing=4
merge_menubar_with_toolbar=false
respect_DE=true
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
small_icon_size=16
spin_button_width=9
submenu_overlap=2
tooltip_delay=-1
tree_branch_line=true
bold_active_tab=false
contrast=1.00
dialog_button_layout=0
hide_combo_checkboxes=false
intensity=1.00
no_inactiveness=false
no_window_pattern=false
reduce_menu_opacity=0
reduce_window_opacity=0
saturation=1.00
scrollable_menu=true
shadowless_popup=false
submenu_delay=200
transient_groove=false
check_size=16
min_height=16
splitter_width=6

[GeneralColors]
window.color=#f4f4f6
base.color=white
alt.base.color=#f4f4f6
button.color=#efebe7
light.color=white
mid.light.color=#bababe
dark.color=#8b8e93
mid.color=#8b8e93
inactive.highlight.color=#4e4e4e
text.color=black
inactive.text.color=black
window.text.color=black
inactive.window.text.color=black
button.text.color=black
disabled.text.color=#00000070
tooltip.text.color=black
highlight.text.color=white
inactive.highlight.text.color=black
highlight.color=#a6a8c1
link.color=#0000ff
link.visited.color=#ff00ff
progress.indicator.text.color=white
progress.inactive.indicator.text.color=black

[Hacks]


[WindowTranslucent]
interior=true
interior.element=window
interior.x.patternsize=32
interior.y.patternsize=32
frame.expansion=0

[Window]
interior=true
interior.element=window


[PanelButtonCommand]
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

frame.expansion=0
interior.element=btn
interior=true
frame=true
frame.element=btn
indicator.size=8

[PanelButtonTool]
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior.element=btn
interior=true
frame=true
frame.element=btn
indicator.size=6

[Dock]
inherits=PanelButtonCommand
interior.element=mubar
frame.element=mubar

text.normal.color=#000000c8

[DockTitle]
#inherits=PanelButtonCommand
interior.element=btn
frame.element=btn
frame=true
interior=true
text.normal.color=black
text.focus.color=black
text.bold=true
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[GenericFrame]
#inherits=PanelButtonCommand
frame=true
interior=true
frame.element=common
interior.element=common
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[LineEdit]
#inherits=PanelButtonCommand
frame.element=ledit
interior.element=ledit
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[IndicatorSpinBox]
indicator.element=spind
indicator.size=9
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[DropDownButton]
inherits=PanelButtonCommand
interior.element=ddown
frame.element=ddown
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ToolboxTab]
inherits=PanelButtonCommand
text.margin.top=4
text.margin.bottom=4
text.margin.left=4
text.margin.right=4

[Tab]
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
focusFrame=true
text.margin.top=4
frame.expansion=0
indicator.size=12
interior.element=tab
frame.element=tab

[TabFrame]
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.element=tbf
interior.element=tbf
frame=true
interior=true

[TreeExpander]
indicator.size=11
indicator.element=tree

[HeaderSection]
frame.element=hdr
interior.element=hdr
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=arrow
indication.size=8

[GroupBox]
interior=true
frame=true
frame.element=gbox
interior.element=gbox
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.bold=false
frame.expansion=0
text.normal.color=black

[TabBarFrame]
frame=true
frame.element=tbframe
interior=true
interior.element=tbframe
frame.top=5
frame.bottom=4
frame.left=4
frame.right=4

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=15

[Toolbar]
frame.left=2
frame.right=2
frame.top=2
frame.bottom=2
indicator.size=3
frame.expansion=0
interior.element=mubar
interior=true
frame=true
frame.element=mubar
indicator.element=tbar
text.normal.color=black

[Scrollbar]
indicator.size=16
frame.expansion=0
indicator.element=scarrow

[ScrollbarGroove]
interior=true
interior.element=trough
frame.element=trough
frame=true
frame.left=1
frame.right=1
frame.top=1
frame.bottom=1

[ScrollbarSlider]
interior=true
frame=true
frame.left=2
frame.right=2
frame.top=2
frame.bottom=2
frame.expansion=0
interior.element=scrollslide
frame.element=scrollslide
indicator.element=sgrip
indicator.size=12

[Progressbar]
text.bold=true
text.normal.color=black
frame.expansion=0
interior.element=ledit
frame.element=ledit
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame=true
interior=true

[ProgressbarContents]
frame=false
interior=true
frame.element=pbc
interior.element=pbc
frame.expansion=0
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[ItemView]
#text.toggle.color=green
#text.press.color=white
#text.normal.color=black
#text.focus.color=white
text.toggle.inactive.color=black
frame.expansion=0
interior=true
interior.element=iview
frame.element=iview
frame=false

[Menu]
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior.element=mnu
frame.element=mnu
frame=true
interior=true
text.focus.color=white
text.toggle.color=white

[MenuItem]
frame=true
frame.element=menuitem
interior=true
interior.element=menuitem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.expansion=0
