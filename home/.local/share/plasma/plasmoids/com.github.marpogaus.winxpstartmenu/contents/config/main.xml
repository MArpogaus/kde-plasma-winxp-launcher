<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <entry name="startText" type="String">
      <label>Text shown on the start button</label>
      <default>start</default>
    </entry>
    <entry name="startIcon" type="String">
      <label>Icon of the start button; empty uses XP's flag if get-microsoft-files.sh installed it, else the bundled flag</label>
      <default></default>
    </entry>
    <entry name="startFontFamily" type="String">
      <label>Font of the start button label</label>
      <default>Franklin Gothic Medium</default>
    </entry>
    <entry name="fontFamily" type="String">
      <label>Font used inside the menu</label>
      <default>Tahoma</default>
    </entry>
    <entry name="numFrequentApps" type="Int">
      <label>Number of frequently used programs</label>
      <default>6</default>
      <min>0</min>
      <max>30</max>
    </entry>
    <entry name="hiddenPlaces" type="StringList">
      <label>Entries of the right column that are hidden</label>
      <default>network,connections,admintools</default>
    </entry>
    <entry name="favoritesInitialized" type="Bool">
      <default>false</default>
    </entry>
  </group>

  <!-- Taskbar and Start Menu Properties: Start Menu tab and its two
       Customize dialogs -->
  <group name="StartMenu">
    <entry name="menuStyle" type="String">
      <label>"xp" for the Windows XP start menu, "classic" for the Classic Start menu</label>
      <default>xp</default>
    </entry>
    <entry name="smallIcons" type="Bool">
      <label>Small icons for the programs on the start menu</label>
      <default>false</default>
    </entry>
    <entry name="showInternet" type="Bool">
      <label>Internet (the default web browser) pinned to the start menu</label>
      <default>true</default>
    </entry>
    <entry name="showEmail" type="Bool">
      <label>E-mail (the default mail program) pinned to the start menu</label>
      <default>true</default>
    </entry>
    <entry name="openSubmenusOnHover" type="Bool">
      <label>Open submenus when the pointer pauses on them</label>
      <default>true</default>
    </entry>
    <entry name="highlightNewPrograms" type="Bool">
      <label>Highlight newly installed programs</label>
      <default>true</default>
    </entry>
    <entry name="menuPlaces" type="StringList">
      <label>Entries of the right column shown as a menu instead of a link</label>
      <default></default>
    </entry>
    <entry name="dragAndDrop" type="Bool">
      <label>Programs can be dragged out of the menu</label>
      <default>true</default>
    </entry>
    <entry name="scrollPrograms" type="Bool">
      <label>Long program menus scroll instead of wrapping into columns</label>
      <default>false</default>
    </entry>
    <entry name="classicSmallIcons" type="Bool">
      <label>Classic Start menu: small icons (without the side banner)</label>
      <default>false</default>
    </entry>
    <entry name="classicShowRun" type="Bool">
      <default>true</default>
    </entry>
    <entry name="classicShowLogOff" type="Bool">
      <default>true</default>
    </entry>
    <entry name="classicExpand" type="StringList">
      <label>Classic Start menu: entries shown as submenus (controlpanel, documents, pictures, music)</label>
      <default></default>
    </entry>
    <entry name="bannerTitle" type="String">
      <label>Classic Start menu banner, bold part</label>
      <default>Windows XP</default>
    </entry>
    <entry name="bannerEdition" type="String">
      <label>Classic Start menu banner, regular part</label>
      <default>Professional</default>
    </entry>
  </group>

  <group name="Places">
    <entry name="myComputerUrl" type="String">
      <default>file:///</default>
    </entry>
    <entry name="networkUrl" type="String">
      <default>remote:/</default>
    </entry>
    <entry name="controlPanelCommand" type="String">
      <default>systemsettings</default>
    </entry>
    <entry name="defaultsCommand" type="String">
      <default>systemsettings kcm_componentchooser</default>
    </entry>
    <entry name="connectionsCommand" type="String">
      <default>systemsettings kcm_networkmanagement</default>
    </entry>
    <entry name="printersCommand" type="String">
      <default>systemsettings kcm_printer_manager</default>
    </entry>
    <entry name="helpCommand" type="String">
      <default>khelpcenter</default>
    </entry>
    <entry name="searchCommand" type="String">
      <default>dbus-send --session --type=method_call --dest=org.kde.krunner /App org.kde.krunner.App.display</default>
    </entry>
    <entry name="runCommand" type="String">
      <default>dbus-send --session --type=method_call --dest=org.kde.krunner /App org.kde.krunner.App.display</default>
    </entry>
  </group>
</kcfg>
