<?xml version="1.0"?>
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<!-- Part of the Windows XP pack: XP Explorer's toolbars. Only toolbars and
     action properties, and a version below any Dolphin's own: KDE then
     takes Dolphin's menus from its own file and carries these over. -->
<gui name="dolphin" version="1">
    <ToolBar noMerge="1" name="mainToolBar" iconText="icontextright" iconSize="24" >
        <text context="@title:menu">Main Toolbar</text>
        <Action name="go_back" />
        <Action name="go_forward" />
        <Action name="go_up" />
        <Separator />
        <Action name="toggle_search" />
        <Action name="show_folders_panel" />
        <Separator />
        <Action name="view_mode" />
        <Action name="hamburger_menu" />
    </ToolBar>
    <ToolBar noMerge="1" name="addressToolBar" newline="true" >
        <text context="@title:menu">Address Bar</text>
        <Action name="url_navigators" />
    </ToolBar>
    <ActionProperties scheme="Default">
        <Action priority="128" name="go_back"/>
        <Action priority="0" name="go_forward"/>
        <Action priority="0" name="go_up" icon="go-parent-folder"/>
        <Action priority="0" name="view_mode"/>
        <Action priority="0" name="view_settings"/>
        <Action priority="128" name="toggle_search" icon="system-search"/>
        <Action priority="128" name="show_folders_panel"/>
    </ActionProperties>
</gui>
